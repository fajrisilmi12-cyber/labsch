#!/usr/bin/env python3
"""labschctl — CLI for labsch-manager server.

Talk to the API server (Hermes) from terminal or chat.
Reads SCHOOL_SERVER_URL and SCHOOL_API_TOKEN from ~/.hermes/.env.

Usage:
  labschctl clients                    # list online/offline clients
  labschctl client <id>                # detail
  labschctl events [--hours 24]        # blocked attempts
  labschctl config show                # current config
  labschctl config block-app <name>
  labschctl config unblock-app <name>
  labschctl config block-site <domain>
  labschctl config unblock-site <domain>
  labschctl config allow-site <domain>
  labschctl token generate|info|revoke # API token management
"""
import argparse
import json
import os
import re
import sys
import urllib.request
import urllib.error
import urllib.parse
from pathlib import Path


def load_env():
    env_file = Path.home() / ".hermes" / ".env"
    if not env_file.exists():
        return None, None
    url = token = None
    for line in env_file.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        # partition splits on the FIRST '=' (maxsplit=1) which is what we want
        # for values that may themselves contain '=' (base64, padded UUIDs).
        k, _, v = line.partition("=")
        k, v = k.strip(), v.strip()
        if k == "SCHOOL_SERVER_URL":
            url = v
        elif k == "SCHOOL_API_TOKEN":
            token = v
    return url, token


SERVER_URL, API_TOKEN = load_env()


def call(method: str, path: str, body: dict = None) -> dict | list | None:
    if not SERVER_URL or not API_TOKEN:
        print("FATAL: SCHOOL_SERVER_URL / SCHOOL_API_TOKEN not in ~/.hermes/.env", file=sys.stderr)
        sys.exit(1)
    # v0.3.4: split path and query BEFORE encoding. Previously the helper
    # treated the whole thing as a path with `/=&?` marked safe, which
    # means `events?hours=24&client_id=<attacker_value>` did not URL-encode
    # user-controlled values, allowing query-string injection (e.g.
    # `--client-id "foo&event_type=blocked-site"` injects an event_type
    # parameter the admin never typed).
    if "?" in path:
        path_only, _, query = path.partition("?")
        qs = urllib.parse.urlencode([(k, v) for k, v in
                                     urllib.parse.parse_qsl(query, keep_blank_values=True)])
        encoded_path = urllib.parse.quote(path_only, safe="/")
        url = f"{SERVER_URL.rstrip('/')}{encoded_path}?{qs}"
    else:
        encoded_path = urllib.parse.quote(path, safe="/")
        url = f"{SERVER_URL.rstrip('/')}{encoded_path}"
    data = json.dumps(body).encode() if body else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("X-Agent-Token", API_TOKEN)
    # Override default Python-urllib UA — Cloudflare edge returns HTTP 1010
    # for python-urllib User-Agent against *.workers.dev (Workers global policy,
    # not configurable per-account). labschctl/0.3.3 is friendly.
    req.add_header("User-Agent", "labschctl/0.3.3")
    if data:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            return json.loads(resp.read().decode())
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", errors="replace")
        print(f"HTTP {e.code}: {body}", file=sys.stderr)
        return None
    except (urllib.error.URLError, OSError) as e:
        print(f"connection error: {e}", file=sys.stderr)
        return None


# Pretty printers
def pp_clients(clients):
    if not clients:
        print("No clients.")
        return
    print(f"{'DISPLAY':<20} {'HOSTNAME':<20} {'STATUS':<8} {'IP':<16} {'TEST':<5} {'LAST SEEN'}")
    print("-" * 90)
    import time
    now = time.time()
    for c in clients:
        age = int(now - (c.get("last_seen") or 0))
        if age < 60:
            age_str = f"{age}s ago"
        elif age < 3600:
            age_str = f"{age//60}m ago"
        else:
            age_str = f"{age//3600}h ago"
        name = c.get("display_name") or c.get("client_id", "")[:18]
        test_mark = "T" if c.get("is_test") else ""
        print(f"{name:<20} {c.get('hostname',''):<20} {c.get('status',''):<8} {c.get('ip',''):<16} {test_mark:<5} {age_str}")


def pp_events(events):
    if not events:
        print("No events.")
        return
    import time
    for e in events:
        ts = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(e.get("timestamp", 0)))
        print(f"  [{ts}] {e.get('client_id',''):<20} {e.get('event_type',''):<20} {e.get('target','')}")


def pp_config(cfg):
    print(json.dumps(cfg, indent=2))


# Subcommand dispatch
def cmd_clients(args):
    pp_clients(call("GET", "/api/clients") or [])


def cmd_client(args):
    c = call("GET", f"/api/clients/{args.client_id}")
    if c:
        print(json.dumps(c, indent=2))
    else:
        print(f"Client {args.client_id} not found.")


def cmd_client_config(args):
    endpoint = f"/api/clients/{args.client_id}/override"
    if args.action == "show":
        print(json.dumps(call("GET", endpoint) or {}, indent=2))
    elif args.action == "clear":
        result = call("DELETE", endpoint)
        if result:
            print(f"OK: {args.client_id} now inherits global config")
    elif args.action == "set":
        # v0.3.4: refuse empty `set`. Previously the call would silently
        # send `{blocked_websites: [], allowed_websites: [], blocked_apps: []}`
        # and wipe the per-PC override entirely — indistinguishable from
        # `clear` but typed as `set` (operator intent: add rules).
        if not (args.blocked_site or args.allowed_site or args.blocked_app):
            print(
                "ERROR: `set` requires at least one of "
                "--blocked-site / --allowed-site / --blocked-app.\n"
                "       Use `clear` if you want to wipe the override "
                "and inherit global.",
                file=sys.stderr,
            )
            sys.exit(2)
        body = {
            "blocked_websites": args.blocked_site or [],
            "allowed_websites": args.allowed_site or [],
            "blocked_apps": args.blocked_app or [],
        }
        result = call("PUT", endpoint, body)
        if result:
            print(f"OK: override saved for {args.client_id}")
            print(json.dumps(result, indent=2))
        else:
            print(f"ERROR: override not saved for {args.client_id}",
                  file=sys.stderr)
            sys.exit(1)


def cmd_events(args):
    params = f"?hours={args.hours}"
    if args.client_id:
        params += f"&client_id={args.client_id}"
    if args.event_type:
        params += f"&event_type={args.event_type}"
    pp_events(call("GET", f"/api/events{params}") or [])


def cmd_config(args):
    if args.action == "show":
        pp_config(call("GET", "/api/admin/config") or {})
        return
    if args.action == "clear-websites":
        result = call("POST", "/api/admin/clear-blocked-websites")
        if result:
            print(f"OK: cleared all sites, config_version = {result.get('config_version')}")
        return
    if args.action == "clear-apps":
        result = call("POST", "/api/admin/clear-blocked-apps")
        if result:
            print(f"OK: cleared all apps, config_version = {result.get('config_version')}")
        return
    if args.action == "clear-allowed":
        result = call("POST", "/api/admin/clear-allowed-websites")
        if result:
            print(f"OK: cleared all allowed, config_version = {result.get('config_version')}")
        return
    body = {"name": args.value}
    endpoint_map = {
        "block-app": "block-app",
        "unblock-app": "unblock-app",
        "block-site": "block-site",
        "unblock-site": "unblock-site",
        "allow-site": "allow-site",
    }
    ep = endpoint_map.get(args.action)
    if not ep:
        print(f"Unknown action: {args.action}", file=sys.stderr)
        sys.exit(1)
    result = call("POST", f"/api/admin/{ep}", body)
    if result:
        print(f"OK: config_version = {result.get('config_version')}")


def cmd_health(args):
    print(json.dumps(call("GET", "/api/health") or {}, indent=2))


def cmd_version(args):
    """Print labschctl + server version. Useful for diagnosing
    client/server version mismatches."""
    CLI_VERSION = "0.3.5"
    print(f"labschctl: {CLI_VERSION}")
    h = call("GET", "/api/health")
    if h:
        print(f"server:   {h.get('version', '?')}")
    else:
        print("server:   unreachable")


def cmd_rename(args):
    """Rename a client (set display_name) via API. v0.3.5: previously
    this wrote directly to SQLite, bypassing the API. Now uses
    PUT /api/clients/{id}/display_name which is also D1-backed."""
    if not re.fullmatch(r"[A-Za-z0-9 ._\-]{1,64}", args.display_name):
        print(f"ERROR: display_name must match [A-Za-z0-9 ._-]{{1,64}}")
        print(f"  got: {args.display_name!r}")
        sys.exit(1)
    # Resolve display_name/hostname to client_id if needed
    client_id = args.client_id
    if not re.fullmatch(r"[A-Za-z0-9._\-]{1,128}", client_id):
        client_id = resolve_client_id(args.client_id)
    result = call("PUT", f"/api/clients/{client_id}/display_name",
                  body={"display_name": args.display_name})
    if result and result.get("ok"):
        print(f"OK: {client_id} renamed to '{args.display_name}'")
    elif result and result.get("detail"):
        print(f"ERROR: {result['detail']}")
        sys.exit(1)


def cmd_unblock_all(args):
    """Clear all blocked_websites, allowed_websites, blocked_apps in 1 command."""
    ok_count = 0
    fail_count = 0
    last_v = None
    for endpoint in ["/api/admin/clear-blocked-websites",
                     "/api/admin/clear-allowed-websites",
                     "/api/admin/clear-blocked-apps"]:
        r = call("POST", endpoint)
        if r:
            print(f"  {endpoint}: OK (v={r.get('config_version')})")
            ok_count += 1
            last_v = r.get('config_version')
        else:
            print(f"  {endpoint}: FAILED", file=sys.stderr)
            fail_count += 1
    if fail_count == 0:
        print(f"Done. All blocks cleared (config_version={last_v}).")
        return
    # v0.3.4: surface partial failure. Previously every failure was
    # silent and the script printed "Done. All blocks cleared." anyway,
    # which misled operators into thinking the system was fully unblocked.
    print(
        f"\nERROR: {fail_count}/{ok_count + fail_count} clear endpoints failed. "
        "Some blocklists may still be in effect.",
        file=sys.stderr,
    )
    sys.exit(1)


def cmd_profile(args):
    if args.action == "list":
        profiles = call("GET", "/api/admin/profiles") or []
        if not profiles:
            print("No profiles saved yet.")
            return
        print(f"{'NAME':<20} {'BLOCKED_SITES':<12} {'ALLOWED_SITES':<12} {'BLOCKED_APPS':<12} {'ACTIVATED':<22}")
        print("-" * 80)
        import time
        for p in profiles:
            activated = "never"
            if p.get("activated_at"):
                activated = time.strftime("%Y-%m-%d %H:%M", time.localtime(p["activated_at"]))
            print(f"{p['name']:<20} {len(p.get('blocked_websites', [])):<12} {len(p.get('allowed_websites', [])):<12} {len(p.get('blocked_apps', [])):<12} {activated:<22}")
        return
    if args.action == "save":
        if not args.name:
            print("ERROR: profile name required for save")
            sys.exit(1)
        # Save current live config as named profile
        cfg = call("GET", "/api/admin/config")
        if not cfg:
            print("ERROR: cannot fetch current config")
            sys.exit(1)
        body = {
            "name": args.name,
            "blocked_apps": cfg.get("blocked_apps", []),
            "blocked_websites": cfg.get("blocked_websites", []),
            "allowed_websites": cfg.get("allowed_websites", []),
        }
        result = call("POST", "/api/admin/profiles", body)
        if result:
            print(f"OK: profile '{args.name}' saved (id={result.get('id')})")
        return
    if args.action == "show":
        if not args.name:
            print("ERROR: profile name required")
            sys.exit(1)
        p = call("GET", f"/api/admin/profiles/{args.name}")
        if p:
            print(json.dumps(p, indent=2))
        else:
            # v0.3.4: surface 404. Previously `call()` already printed
            # `HTTP 404: ...` to stderr but this function exited 0 with
            # no stdout, leaving the operator to think `show` succeeded.
            print(f"ERROR: profile '{args.name}' not found",
                  file=sys.stderr)
            sys.exit(1)
        return
    if args.action == "activate":
        if not args.name:
            print("ERROR: profile name required")
            sys.exit(1)
        result = call("POST", f"/api/admin/profiles/{args.name}/activate")
        if result:
            print(f"OK: profile '{args.name}' activated, config_version = {result.get('config_version')}")
        else:
            print(f"ERROR: profile '{args.name}' not activated (does it exist?)",
                  file=sys.stderr)
            sys.exit(1)
        return
    if args.action == "delete":
        if not args.name:
            print("ERROR: profile name required")
            sys.exit(1)
        result = call("DELETE", f"/api/admin/profiles/{args.name}")
        if result:
            print(f"OK: deleted profile '{args.name}'")
        return


def resolve_client_id(name: str) -> str:
    """Resolve display_name or hostname to client_id. Falls back to the
    input itself if no match (assume caller passed a raw client_id)."""
    clients = call("GET", "/api/clients") or []
    needle = name.lower().strip()
    if not needle:
        return name
    # v0.3.4: exact-match (case-insensitive) against display_name, hostname,
    # and client_id. Previously used `name.lower() in (...)` which is a
    # SUBSTRING match — typing `pc` would match BOTH `PC-LAB-01` and
    # `PC-GURU-FAJRI` and return whichever the server happened to send
    # first. Typing 3 chars of any UUID silently targeted that client.
    for c in clients:
        display = (c.get("display_name") or "").strip()
        hostname = (c.get("hostname") or "").strip()
        cid = (c.get("client_id") or "").strip()
        if (needle == display.lower()
                or needle == hostname.lower()
                or needle == cid.lower()):
            return cid
    return name  # assume raw client_id


def _parse_download_dest(raw):
    """Map CLI --dest to canonical destination for the server."""
    if raw in (None, "", "desktop", "documents"):
        return raw or "desktop"
    raise SystemExit("ERROR: --dest must be 'desktop' or 'documents' (v1 limit)")


def cmd_download(args):
    """Queue a file download task for explicitly targeted clients."""
    url = args.url
    filename = args.name
    dest = _parse_download_dest(args.dest)
    autorun = bool(args.autorun)
    sha256 = args.sha256
    # Validate inputs before any network call.
    if args.group:
        raise SystemExit("ERROR: groups unsupported in this test release; use --clients")
    if not (args.clients or args.group):
        print("ERROR: no explicit target; specify --clients or --group (implicit broadcast not allowed)",
              file=sys.stderr)
        sys.exit(1)
    if autorun and not sha256:
        print("ERROR: --sha256 is required when autorun is enabled (safety gate)", file=sys.stderr)
        sys.exit(1)
    clients = [resolve_client_id(c) for c in (args.clients or [])]
    groups = [args.group] if args.group else []
    body = {"url": url, "autorun": autorun, "clients": clients, "groups": groups,
            "sha256": (sha256.lower() if sha256 else None)}
    if filename:
        body["filename"] = filename
    if dest != "desktop":
        body["destination"] = dest
    if sha256:
        body["sha256"] = sha256.lower()
    if getattr(args, "max_size_mb", None):
        body["max_size_mb"] = args.max_size_mb
    if getattr(args, "ttl_seconds", None):
        body["ttl_seconds"] = args.ttl_seconds
    if getattr(args, "run_as", None) and args.run_as != "user":
        body["run_as"] = args.run_as
    result = call("POST", "/api/admin/downloads", body)
    if result:
        tid = result.get("task_id", "?")
        missing = result.get("missing_clients", [])
        print(f"OK: download task queued {tid}")
        print(f"  Protocol: {result.get('protocol', '?')}")
        if missing:
            print(f"  Missing clients: {', '.join(missing)}")
        print("  Upgraded agent polls every 30s; jitter/backlog may delay start")
    return result


def cmd_downloads(args):
    """List download tasks with per-client rollup."""
    result = call("GET", "/api/admin/downloads")
    if not result:
        return
    tasks = result.get("tasks", [])
    if not tasks:
        print("No download tasks.")
        return
    print(f"{'TASK_ID':36} {'STATUS':<8} {'AUTO':<4} {'FILENAME':<32} {'ROLLUP'}")
    print("-" * 110)
    for t in tasks:
        tid = t.get("task_id", "?")
        status = t.get("status", "?")
        autorun = "Y" if t.get("autorun") else "N"
        fn = t.get("filename", "?")
        rollup = t.get("rollup", {})
        roll_str = " ".join(f"{k}:{v}" for k, v in rollup.items() if v) if rollup else "-"
        print(f"{tid} {status:<8} {autorun:<4} {fn:<32} {roll_str}")
        for row in t.get("clients", []):
            print(f"  {row['client_id']}: download={row['download_state']} execution={row['execution_state']}")
    return result


def cmd_download_cancel(args):
    """Cancel a download task (agents will stop receiving it)."""
    result = call("POST", f"/api/admin/downloads/{args.task_id}/cancel")
    if result:
        print(f"OK: download task {args.task_id} cancelled")
    return result


def cmd_command(args):
    cid = resolve_client_id(args.client_id)
    if args.action == "cancel":
        result = call("DELETE", f"/api/admin/command/{cid}")
        if result:
            print(f"OK: cancelled pending command for {cid}")
        return
    # v0.3.5: handle 'notify' (requires --message) and 'lock'.
    if args.action == "notify":
        if not args.message:
            print("ERROR: 'notify' requires --message / -m", file=sys.stderr)
            sys.exit(1)
        # v0.3.5: also validate locally for defense-in-depth — server
        # already rejects but a clear error here saves a round-trip.
        for ch in args.message:
            if ch in ('"', "'", '`', '$', '\\'):
                print(f"ERROR: message contains forbidden char: {ch!r}", file=sys.stderr)
                sys.exit(1)
        if len(args.message) > 200:
            print("ERROR: message >200 chars", file=sys.stderr)
            sys.exit(1)
        msg_enc = urllib.parse.quote(args.message, safe="")
        url = f"/api/admin/command/{cid}?command=notify&message={msg_enc}"
    else:
        url = f"/api/admin/command/{cid}?command={args.action}"
    result = call("POST", url)
    if result:
        print(f"OK: {result.get('command')} queued for {cid}")
        print("  Agent will execute on next heartbeat (≤30s)")


def cmd_command_all(args):
    """Queue shutdown/restart/lock/notify for all online (or all) clients at once."""
    if args.action == "cancel":
        print("Cancelling pending commands on ALL clients...")
        clients = call("GET", "/api/clients") or []
        ok = 0
        for c in clients:
            if (c.get("pending_command") or "").strip():
                cid = c.get("client_id")
                result = call("DELETE", f"/api/admin/command/{cid}")
                if result:
                    ok += 1
                    print(f"  OK: cancelled for {c.get('display_name') or cid}")
        print(f"Done. Cancelled {ok} pending command(s).")
        return

    if args.action == "notify" and not args.message:
        print("ERROR: 'notify' requires --message / -m", file=sys.stderr)
        sys.exit(1)

    # v0.3.5: allowed actions include lock and notify now.
    if args.action not in ("shutdown", "restart", "lock", "notify", "launcher_start", "launcher_stop"):
        print(f"Unknown action: {args.action}", file=sys.stderr)
        sys.exit(2)

    clients = call("GET", "/api/clients") or []
    if not clients:
        print("No clients found.")
        return

    targets = []
    for c in clients:
        if args.online_only and c.get("status") != "online":
            continue
        targets.append(c)

    if not targets:
        # v0.3.4: distinguish "no clients at all" from "filter excluded all".
        # Previously both printed the same message and exited 0; an operator
        # running `command-all shutdown --online-only --yes` during a network
        # outage would see "Done. Queued: 0" and assume the system was empty.
        if args.online_only and clients:
            print(
                f"WARNING: --online-only excluded all {len(clients)} "
                "client(s) — none are currently online. Nothing to do.",
                file=sys.stderr,
            )
            sys.exit(2)
        print("No matching clients.")
        return

    if not args.yes:
        print(f"About to queue '{args.action}' for {len(targets)} client(s):")
        for c in targets:
            label = c.get("display_name") or c.get("client_id")
            mark = " [test PC]" if c.get("is_test") else ""
            print(f"  - {label} ({c.get('client_id')}){mark}")
        if args.action == "shutdown":
            print("WARNING: this will turn off the PCs. Pass --yes to skip prompt.")
        confirm = input("Proceed? [y/N] ").strip().lower()
        if confirm != "y":
            print("Aborted.")
            return

    ok, fail = 0, 0
    msg_enc = ""
    if args.action == "notify":
        msg_enc = urllib.parse.quote(args.message, safe="")
    for c in targets:
        cid = c.get("client_id")
        if args.action == "notify":
            url = f"/api/admin/command/{cid}?command=notify&message={msg_enc}"
        else:
            url = f"/api/admin/command/{cid}?command={args.action}"
        result = call("POST", url)
        if result:
            ok += 1
            print(f"  OK: {args.action} queued for {c.get('display_name') or cid}")
        else:
            fail += 1
            print(f"  FAIL: {cid}")
    print(f"Done. Queued: {ok}, Failed: {fail}")


def cmd_token(args):
    """Manage API token (Workers / D1 deployment).

    generate  — generate a fresh random token (returned once)
    info      — show fingerprint + created_at of the current token
    revoke    — clear KV metadata (force a new token on next deploy)
    """
    if args.action == "generate":
        if not args.yes:
            print("This will generate a NEW API token.")
            print("The OLD token (if any) will continue to work until you redeploy")
            print("with the new SCHOOL_API_TOKEN secret.")
            confirm = input("Proceed? [y/N] ").strip().lower()
            if confirm != "y":
                print("Aborted.")
                return
        result = call("POST", "/api/admin/token/generate")
        if result:
            print("=" * 60)
            print(f"NEW API TOKEN  (length={result.get('length')})")
            print(f"  fingerprint : {result.get('fingerprint')}")
            print(f"  created_at  : {result.get('created_at')}")
            print(f"  token       : {result.get('token')}")
            print("=" * 60)
            print()
            print("SAVE THIS NOW — the token will not be shown again.")
            print()
            print("Next steps:")
            print("  1. wrangler secret put SCHOOL_API_TOKEN")
            print(f"     (paste: {result.get('token')})")
            print("  2. wrangler deploy")
            print("  3. Update agent config.ini or install.bat on all clients with the new token")
            print("  4. labschctl token info    # confirm after deploy")
        return

    if args.action == "info":
        info = call("GET", "/api/admin/token/info")
        if info:
            if info.get("detail"):
                print(f"ERROR: {info['detail']}")
            elif info.get("registered_fingerprints"):
                # v0.3.5: list all registered fingerprints
                fps = info["registered_fingerprints"]
                if not fps:
                    print("No tokens registered yet (only bootstrap token active).")
                    return
                print(f"Bootstrap token active: {info.get('bootstrap_token_active', '?')}")
                print(f"Registered fingerprints: {len(fps)}")
                import time
                for fp in fps:
                    ts = time.strftime("%Y-%m-%d %H:%M:%S",
                                       time.localtime(fp.get("created_at", 0)))
                    print(f"  {fp.get('fingerprint', '?')[:16]}...  created {ts}")
            else:
                print("No token has been generated yet.")
                print("Run: labschctl token generate")
        return

    if args.action == "revoke":
        if not args.fingerprint:
            print("ERROR: --fingerprint is required. Get it from 'labschctl token info'.")
            print("Example: labschctl token revoke --fingerprint abc123... --yes")
            sys.exit(1)
        # Validate fingerprint shape
        if not re.fullmatch(r"[0-9a-f]{64}", args.fingerprint.lower()):
            print("ERROR: fingerprint must be 64 hex chars (full SHA-256)")
            sys.exit(1)
        if not args.yes:
            print(f"This will REVOKE the token with fingerprint {args.fingerprint[:16]}...")
            print("The token will be rejected on next request.")
            confirm = input("Proceed? [y/N] ").strip().lower()
            if confirm != "y":
                print("Aborted.")
                return
        result = call("DELETE", f"/api/admin/token/{args.fingerprint}")
        if result:
            print(f"OK: revoked fingerprint {args.fingerprint[:16]}...")
        return


def main():
    parser = argparse.ArgumentParser(description="labschctl — control labsch-manager server")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_clients = sub.add_parser("clients", help="list all clients")
    p_clients.set_defaults(func=cmd_clients)

    p_client = sub.add_parser("client", help="client detail")
    p_client.add_argument("client_id")
    p_client.set_defaults(func=cmd_client)

    p_client_config = sub.add_parser("client-config", help="per-PC blocking override")
    p_client_config.add_argument("action", choices=["show", "set", "clear"])
    p_client_config.add_argument("client_id")
    p_client_config.add_argument("--blocked-site", action="append", help="domain to block (repeatable)")
    p_client_config.add_argument("--allowed-site", action="append", help="domain to allow (repeatable)")
    p_client_config.add_argument("--blocked-app", action="append", help="EXE to block (repeatable)")
    p_client_config.set_defaults(func=cmd_client_config)

    p_events = sub.add_parser("events", help="blocked attempts log")
    p_events.add_argument("--hours", type=int, default=24)
    p_events.add_argument("--client-id")
    p_events.add_argument("--event-type")
    p_events.set_defaults(func=cmd_events)

    p_config = sub.add_parser("config", help="view/edit blocklist")
    p_config.add_argument("action", choices=["show", "block-app", "unblock-app",
                                              "block-site", "unblock-site", "allow-site",
                                              "clear-websites", "clear-apps",
                                              "clear-allowed", "set-config"])
    p_config.add_argument("value", nargs="?", help="name/domain (not needed for show/clear)")
    p_config.set_defaults(func=cmd_config)

    p_health = sub.add_parser("health", help="server health")
    p_health.set_defaults(func=cmd_health)

    p_version = sub.add_parser("version", help="print labschctl + server version")
    p_version.set_defaults(func=cmd_version)

    p_profile = sub.add_parser("profile", help="manage named profiles (e.g. 'Rules Lab')")
    p_profile.add_argument("action", choices=["list", "save", "show", "activate", "delete"])
    p_profile.add_argument("name", nargs="?", help="profile name")
    p_profile.set_defaults(func=cmd_profile)

    p_unblock = sub.add_parser("unblock-all", help="1-command: clear all blocks (websites + allowed + apps)")
    p_unblock.set_defaults(func=cmd_unblock_all)

    p_rename = sub.add_parser("rename", help="rename a client (set display_name)")
    p_rename.add_argument("client_id", help="current client_id")
    p_rename.add_argument("display_name", help="new display name (e.g. PC-LAB-01)")
    p_rename.set_defaults(func=cmd_rename)

    p_command = sub.add_parser("command", help="remote shutdown/restart/lock/notify/launcher a PC")
    p_command.add_argument("action", choices=["shutdown", "restart", "lock", "notify", "cancel",
                                              "launcher_start", "launcher_stop"])
    p_command.add_argument("client_id", help="target client ID (or display name / hostname)")
    p_command.add_argument("-m", "--message", help="message text (for 'notify' action)")
    p_command.set_defaults(func=cmd_command)

    p_command_all = sub.add_parser("command-all", help="queue shutdown/restart to MANY PCs at once")
    p_command_all.add_argument("action", choices=["shutdown", "restart", "lock", "notify", "cancel",
                                                  "launcher_start", "launcher_stop"])
    p_command_all.add_argument("--online-only", action="store_true",
                               help="only target clients currently online")
    p_command_all.add_argument("--yes", action="store_true",
                               help="skip confirmation prompt")
    p_command_all.add_argument("-m", "--message", help="message text (for 'notify' action)")
    p_command_all.set_defaults(func=cmd_command_all)

    p_token = sub.add_parser("token", help="manage API token (Workers KV-backed)")
    p_token.add_argument("action", choices=["generate", "info", "revoke"])
    p_token.add_argument("--fingerprint", help="full 64-char SHA-256 fingerprint (for revoke)")
    p_token.add_argument("--yes", action="store_true", help="skip confirmation prompt")
    p_token.set_defaults(func=cmd_token)

    # --- download feature (v0.4.0) ---
    p_dl = sub.add_parser("download", help="queue a file download (+optional autorun) for clients")
    p_dl.add_argument("url", help="source URL (direct https, or Google Drive / OneDrive share link)")
    p_dl.add_argument("--name", help="target filename (default: derived from URL; sanitized)")
    p_dl.add_argument("--dest", default="desktop", help="desktop|documents (default desktop)")
    p_dl.add_argument("--no-autorun", "--no-run", dest="autorun", action="store_false", default=True,
                      help="download only, do not run (autorun is default)")
    p_dl.add_argument("--sha256", help="expected SHA-256 (64 hex); REQUIRED when autorun enabled")
    p_dl.add_argument("--clients", nargs="+", metavar="CLIENT",
                     help="one or more client IDs / display names / hostnames")
    p_dl.add_argument("--group", help="group name to target (instead of --clients)")
    p_dl.add_argument("--max-size-mb", type=int, dest="max_size_mb", default=None,
                      help="per-file size cap in MB (server default 200 MB)")
    p_dl.add_argument("--ttl-seconds", type=int, dest="ttl_seconds", default=None,
                      help="task expiry (server default 7 days)")
    p_dl.add_argument("--run-as", choices=["user"], default="user",
                      help="execution context (v0.4.0: 'user' only; system context deliberately unsupported)")
    p_dl.set_defaults(func=cmd_download)

    p_dls = sub.add_parser("downloads", help="list download tasks + per-client rollup")
    p_dls.set_defaults(func=cmd_downloads)

    p_dlc = sub.add_parser("download-cancel", help="cancel a download task")
    p_dlc.add_argument("task_id", help="task UUID from 'downloads' listing")
    p_dlc.set_defaults(func=cmd_download_cancel)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
